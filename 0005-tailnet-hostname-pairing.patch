+/**
+ * Scheme for an address typed without one. A T3 server reached directly (LAN, tailnet IP,
+ * MagicDNS on any tailnet domain, Headscale included) listens on a port and speaks plain
+ * http; HTTPS (Tailscale Serve, a reverse proxy) sits on the default port. So an explicit
+ * non-443 port or an IP literal means http; a bare name means https. Type https:// to override.
+ */
+export const defaultSchemeForHost = (hostWithPort: string): "http" | "https" => {
+  try {
+    const { hostname, port } = new URL(`http://${hostWithPort}`);
+    const host = hostname.replace(/^\[|\]$/g, "");
+    if (host.includes(":") || /^\d{1,3}(\.\d{1,3}){3}$/.test(host)) return "http";
+    if (port !== "" && port !== "443") return "http";
+    // Single-label names (MagicDNS short names, mDNS-less LAN hosts) have no certificate.
+    return host.includes(".") ? "https" : "http";
+  } catch {
+    return "https";
+  }
+};
