     });
 
+    // Only offer the hostname when the backend is reachable on the tailnet interface.
+    const magicDnsHttpEndpoint =
+      ipEndpoints.length > 0
+        ? resolveTailscaleMagicDnsHttpEndpoint({
+            dnsName: status?.magicDnsName ?? null,
+            port: input.port,
+          })
+        : null;
+    const directEndpoints =
+      magicDnsHttpEndpoint === null ? ipEndpoints : [...ipEndpoints, magicDnsHttpEndpoint];
+
     return Option.match(magicDnsEndpoint, {
-      onNone: () => ipEndpoints,
-      onSome: (endpoint) => [...ipEndpoints, endpoint],
+      onNone: () => directEndpoints,
+      onSome: (endpoint) => [...directEndpoints, endpoint],
     });
   },
 );
