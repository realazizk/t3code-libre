+/** Plain-http MagicDNS name for the directly exposed backend, so phones can pair by hostname. */
+function resolveTailscaleMagicDnsHttpEndpoint(input: {
+  readonly dnsName: string | null;
+  readonly port: number;
+}): AdvertisedEndpoint | null {
+  if (!input.dnsName) return null;
+  const url = new URL(`http://${input.dnsName}`);
+  url.port = String(input.port);
+  const httpBaseUrl = url.origin;
+  return createAdvertisedEndpoint({
+    provider: TAILSCALE_ENDPOINT_PROVIDER,
+    source: "desktop-addon",
+    id: `tailscale-magicdns-http:${httpBaseUrl}`,
+    label: "Tailscale MagicDNS",
+    httpBaseUrl,
+    reachability: "private-network",
+    status: "available",
+    description: "Reachable by hostname from devices on the same Tailnet.",
+  });
+}
+
