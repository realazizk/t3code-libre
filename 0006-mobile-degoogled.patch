index 0000000..b672b82
--- /dev/null
+++ b/apps/mobile/src/features/connection/usePairingQrScanner.android.tsx
@@ -0,0 +1,44 @@
+import * as Dialog from "../../components/ui/Dialog";
+import { requireOptionalNativeModule } from "expo";
+import { useGT } from "gt-react-native";
+import { useState } from "react";
+
+import type { PairingQrScanner } from "./usePairingQrScanner";
+
+type QrScannerModule = {
+  /** Resolves the scanned text, or "" when the user leaves the scanner. */
+  scanAsync(prompt: string): Promise<string>;
+};
+
+// modules/t3-qr-scanner: ZXing in its own activity, so no ML Kit or Google Play Services.
+const native = requireOptionalNativeModule<QrScannerModule>("T3QrScanner");
+
+export function usePairingQrScanner(onScan: (data: string) => boolean): PairingQrScanner {
+  const gt = useGT();
+  // A second tap while the scanner opens would get the module's "already open" rejection.
+  const [scanning, setScanning] = useState(false);
+
+  const start = async () => {
+    if (scanning) return;
+    if (!native) {
+      Dialog.alert(gt("Scanning unavailable"), gt("Enter the address and pairing code instead."));
+      return;
+    }
+    setScanning(true);
+    try {
+      const data = await native.scanAsync(
+        gt("Scan the code from t3 pair or desktop Connections settings"),
+      );
+      if (data) onScan(data);
+    } catch (error) {
+      Dialog.alert(
+        gt("Scanning unavailable"),
+        error instanceof Error ? error.message : gt("The QR scanner could not open."),
+      );
+    } finally {
+      setScanning(false);
+    }
+  };
+
+  return { cameraActive: false, preview: null, start: () => void start() };
+}
diff --git a/apps/mobile/src/features/connection/usePairingQrScanner.tsx b/apps/mobile/src/features/connection/usePairingQrScanner.tsx
