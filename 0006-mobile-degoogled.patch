diff --git a/apps/mobile/plugins/withNoGooglePlayServices.cjs b/apps/mobile/plugins/withNoGooglePlayServices.cjs
new file mode 100644
index 0000000..12ae369
--- /dev/null
+++ b/apps/mobile/plugins/withNoGooglePlayServices.cjs
@@ -0,0 +1,100 @@
+const {
+  AndroidConfig,
+  withAndroidManifest,
+  withGradleProperties,
+  withProjectBuildGradle,
+} = require("expo/config-plugins");
+
+// The Android build ships without Google Play Services, Firebase, ML Kit, or Play libraries.
+// Anything that still asks for them is stripped from every runtime classpath, so a new
+// dependency cannot quietly bring them back; scripts/build-android-private.sh then fails the
+// build if any of them reaches the release classpath or manifest.
+const EXCLUDED_GROUPS = [
+  "com.google.firebase",
+  "com.google.android.gms",
+  "com.google.mlkit",
+  "com.google.android.play",
+  "com.android.installreferrer",
+];
+
+// Compile classpaths keep them: expo-notifications builds from source and its remote-push
+// classes reference Firebase types. Those classes only run for FCM messages and token calls,
+// which this build never registers for.
+const GRADLE_MARKER = "t3code-no-google-play-services";
+const GRADLE_BLOCK = `
+// @generated begin ${GRADLE_MARKER}
+allprojects {
+  configurations.matching { it.name.endsWith("RuntimeClasspath") }.configureEach {
+${EXCLUDED_GROUPS.map((group) => `    exclude group: "${group}"`).join("\n")}
+  }
+}
+// @generated end ${GRADLE_MARKER}
+`;
+
+const GRADLE_PROPERTIES = {
+  // expo-camera is not autolinked on Android (package.json), but keep its ML Kit scanners off
+  // in case it ever is.
+  "expo.camera.barcode-scanner-enabled": "false",
+  "expo.camera.document-scanner-enabled": "false",
+  // react-native-pdf-jsi's optional OCR uses ML Kit text recognition.
+  pdfJsiEnableOcr: "false",
+};
+
+const FIREBASE_MESSAGING_SERVICE =
+  "expo.modules.notifications.service.ExpoFirebaseMessagingService";
+
+function withExcludedRuntimeGroups(config) {
+  return withProjectBuildGradle(config, (nextConfig) => {
+    if (nextConfig.modResults.language !== "groovy") {
+      throw new Error("withNoGooglePlayServices expects a Groovy android/build.gradle.");
+    }
+    if (!nextConfig.modResults.contents.includes(`@generated begin ${GRADLE_MARKER}`)) {
+      nextConfig.modResults.contents += GRADLE_BLOCK;
+    }
+    return nextConfig;
+  });
+}
+
+function withDisabledGoogleFeatures(config) {
+  return withGradleProperties(config, (nextConfig) => {
+    const keys = new Set(Object.keys(GRADLE_PROPERTIES));
+    nextConfig.modResults = nextConfig.modResults.filter(
+      (item) => !(item.type === "property" && keys.has(item.key)),
+    );
+    for (const [key, value] of Object.entries(GRADLE_PROPERTIES)) {
+      nextConfig.modResults.push({ type: "property", key, value });
+    }
+    return nextConfig;
+  });
+}
+
+function withoutFirebaseMessagingService(config) {
+  return withAndroidManifest(config, (nextConfig) => {
+    const manifest = nextConfig.modResults.manifest;
+    manifest.$ ??= {};
+    manifest.$["xmlns:tools"] ??= "http://schemas.android.com/tools";
+    const application = AndroidConfig.Manifest.getMainApplicationOrThrow(nextConfig.modResults);
+    application.service = (application.service ?? []).filter(
+      (service) => service.$?.["android:name"] !== FIREBASE_MESSAGING_SERVICE,
+    );
+    application.service.push({
+      $: { "android:name": FIREBASE_MESSAGING_SERVICE, "tools:node": "remove" },
+    });
+    // expo-notifications writes FCM icon/colour meta-data; nothing reads it without Firebase.
+    application["meta-data"] = (application["meta-data"] ?? []).filter(
+      (entry) => !entry.$?.["android:name"]?.startsWith("com.google.firebase."),
+    );
+    return nextConfig;
+  });
+}
+
+module.exports = function withNoGooglePlayServices(config) {
+  if (config.android?.googleServicesFile) {
+    throw new Error(
+      "android.googleServicesFile is set, but this build must not include Firebase or Google Play Services.",
+    );
+  }
+  return withoutFirebaseMessagingService(
+    withDisabledGoogleFeatures(withExcludedRuntimeGroups(config)),
+  );
+};
