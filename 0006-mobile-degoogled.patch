index 0000000..eeb0d6f
--- /dev/null
+++ b/apps/mobile/scripts/build-android-private.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+# Builds a release APK with no Google Play Services, Firebase, ML Kit, Play libraries,
+# telemetry, T3 account, or T3 cloud configuration, then fails if any of them slipped in.
+#
+#   ANDROID_HOME=~/Android/Sdk JAVA_HOME=/usr/lib/jvm/java-21-openjdk \
+#     apps/mobile/scripts/build-android-private.sh
+#
+# Optional: T3CODE_ANDROID_PACKAGE (default com.t3tools.t3code.libre) and, to sign,
+# T3CODE_ANDROID_KEYSTORE, T3CODE_ANDROID_KEYSTORE_ALIAS, T3CODE_ANDROID_KEYSTORE_PASSWORD.
+set -euo pipefail
+
+MOBILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$MOBILE_DIR"
+
+fail() {
+  echo "error: $*" >&2
+  exit 1
+}
+
+if [[ -z "${ANDROID_HOME:-}" || ! -d "${ANDROID_HOME}" ]]; then
+  fail "ANDROID_HOME must point at an Android SDK (with platform-tools, build-tools and an NDK)."
+fi
+
+JAVA_BIN="${JAVA_HOME:+$JAVA_HOME/bin/}java"
+command -v "$JAVA_BIN" >/dev/null 2>&1 || fail "No java found. Set JAVA_HOME to a JDK 17 or 21."
+JAVA_VERSION="$("$JAVA_BIN" -version 2>&1 | sed -n 's/.*version "\([0-9]*\).*/\1/p' | head -n 1)"
+if [[ "$JAVA_VERSION" != "17" && "$JAVA_VERSION" != "21" ]]; then
+  fail "Gradle needs JDK 17 or 21, found '${JAVA_VERSION:-unknown}'. Set JAVA_HOME to one of those."
+fi
+
+export APP_VARIANT=production
+export T3CODE_ANDROID_PACKAGE="${T3CODE_ANDROID_PACKAGE:-com.t3tools.t3code.libre}"
+export EXPO_NO_TELEMETRY=1
+export EXPO_NO_GIT_STATUS=1
+export NODE_ENV=production
+
+# Nothing cloud-shaped reaches the build, whatever the shell or a .env file holds.
+# (scripts/lib/public-config.ts also drops CLERK/RELAY/OTLP_TRACES keys from .env files.)
+while IFS= read -r name; do
+  unset "$name"
+done < <(env | cut -d= -f1 | grep -E 'CLERK|RELAY|OTLP|GOOGLE_SERVICES|SENTRY|POSTHOG|AXIOM' || true)
+unset T3CODE_MOBILE_UPDATES_ENABLED EXPO_TOKEN
+
+echo "==> Prebuilding android (${T3CODE_ANDROID_PACKAGE})"
+npx expo prebuild --clean --platform android --no-install
+
+[[ -e android/app/google-services.json ]] && fail "android/app/google-services.json exists; this build must not use Firebase."
+
+cd android
+echo "==> Building release APK"
+./gradlew assembleRelease
+
+echo "==> Checking the release runtime classpath"
+DEPENDENCIES="$(./gradlew -q :app:dependencies --configuration releaseRuntimeClasspath)"
+BANNED='com\.google\.(firebase|android\.gms|mlkit|android\.play)|installreferrer'
+if grep -E "$BANNED" <<<"$DEPENDENCIES"; then
+  fail "the release runtime classpath contains the Google libraries listed above."
+fi
+
+echo "==> Checking the merged release manifest"
+MANIFEST="$(find app/build/intermediates -path '*release*' -name AndroidManifest.xml -path '*merged_manifest*' | head -n 1)"
+[[ -n "$MANIFEST" ]] || fail "could not find the merged release manifest under app/build/intermediates."
+if grep -nE 'com\.google\.firebase|c2dm|MESSAGING_EVENT' "$MANIFEST"; then
+  fail "the merged manifest ($MANIFEST) still declares Firebase messaging."
+fi
+
+APK_DIR="$PWD/app/build/outputs/apk/release"
+UNSIGNED_APK="$(find "$APK_DIR" -name '*.apk' | head -n 1)"
+[[ -n "$UNSIGNED_APK" ]] || fail "no APK found in $APK_DIR."
+
+if [[ -n "${T3CODE_ANDROID_KEYSTORE:-}" ]]; then
+  : "${T3CODE_ANDROID_KEYSTORE_ALIAS:?set T3CODE_ANDROID_KEYSTORE_ALIAS with T3CODE_ANDROID_KEYSTORE}"
+  : "${T3CODE_ANDROID_KEYSTORE_PASSWORD:?set T3CODE_ANDROID_KEYSTORE_PASSWORD with T3CODE_ANDROID_KEYSTORE}"
+  BUILD_TOOLS="$(find "$ANDROID_HOME/build-tools" -mindepth 1 -maxdepth 1 -type d | sort -V | tail -n 1)"
+  [[ -x "$BUILD_TOOLS/apksigner" ]] || fail "apksigner not found under $ANDROID_HOME/build-tools."
+  ALIGNED_APK="$APK_DIR/t3code-private-aligned.apk"
+  SIGNED_APK="$APK_DIR/t3code-private-signed.apk"
+  "$BUILD_TOOLS/zipalign" -f -p 4 "$UNSIGNED_APK" "$ALIGNED_APK"
+  T3CODE_KS_PASS="$T3CODE_ANDROID_KEYSTORE_PASSWORD" "$BUILD_TOOLS/apksigner" sign \
+    --ks "$T3CODE_ANDROID_KEYSTORE" \
+    --ks-key-alias "$T3CODE_ANDROID_KEYSTORE_ALIAS" \
+    --ks-pass env:T3CODE_KS_PASS \
+    --key-pass env:T3CODE_KS_PASS \
+    --out "$SIGNED_APK" "$ALIGNED_APK"
+  "$BUILD_TOOLS/apksigner" verify "$SIGNED_APK"
+  rm -f "$ALIGNED_APK"
+  echo "==> Signed APK: $SIGNED_APK"
+else
+  echo "==> APK: $UNSIGNED_APK"
+  echo "    Release builds from a fresh prebuild are signed with the debug keystore (or not at all)."
+  echo "    Sign it with your own keystore before installing: set T3CODE_ANDROID_KEYSTORE,"
+  echo "    T3CODE_ANDROID_KEYSTORE_ALIAS and T3CODE_ANDROID_KEYSTORE_PASSWORD and rerun, or use apksigner."
+fi
