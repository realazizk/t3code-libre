@@ -0,0 +1,60 @@
+import * as Dialog from "../../components/ui/Dialog";
+import { useIsFocused } from "@react-navigation/native";
+import { CameraView, useCameraPermissions } from "expo-camera";
+import { useGT } from "gt-react-native";
+import { type ReactNode, useState } from "react";
+import { Linking, StyleSheet } from "react-native";
+
+export interface PairingQrScanner {
+  /** Whether the inline camera preview is live. */
+  readonly cameraActive: boolean;
+  /** The inline camera preview, or null where scanning happens in a separate screen. */
+  readonly preview: ReactNode;
+  readonly start: () => void;
+}
+
+/**
+ * Scans pairing QR codes with an inline AVFoundation preview (expo-camera). Android uses
+ * usePairingQrScanner.android.tsx, which avoids ML Kit and Google Play Services.
+ * `onScan` returns true when it accepted the code, which parks the camera.
+ */
+export function usePairingQrScanner(onScan: (data: string) => boolean): PairingQrScanner {
+  const gt = useGT();
+  const [cameraPermission, requestCameraPermission] = useCameraPermissions();
+  const screenFocused = useIsFocused();
+  // A good scan parks the camera so it can't re-read the code over later edits.
+  const [scanComplete, setScanComplete] = useState(false);
+  const cameraActive = cameraPermission?.granted === true && screenFocused && !scanComplete;
+
+  const start = async () => {
+    const permission = await requestCameraPermission();
+    if (permission.granted) {
+      setScanComplete(false);
+      return;
+    }
+    if (permission.canAskAgain) return;
+    Dialog.alert(
+      gt("Camera access needed"),
+      gt("Camera access was denied for this app. Open Settings to enable it."),
+      [
+        { text: gt("Cancel"), style: "cancel" },
+        { text: gt("Open Settings"), onPress: () => void Linking.openSettings() },
+      ],
+    );
+  };
+
+  return {
+    cameraActive,
+    preview: cameraActive ? (
+      <CameraView
+        active
+        barcodeScannerSettings={{ barcodeTypes: ["qr"] }}
+        onBarcodeScanned={({ data }) => {
+          if (onScan(data)) setScanComplete(true);
+        }}
+        style={StyleSheet.absoluteFill}
+      />
+    ) : null,
+    start: () => void start(),
+  };
+}
