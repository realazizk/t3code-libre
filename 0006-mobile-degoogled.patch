@@ -0,0 +1,56 @@
+package expo.modules.t3qrscanner
+
+import com.journeyapps.barcodescanner.ScanIntentResult
+import com.journeyapps.barcodescanner.ScanOptions
+import expo.modules.kotlin.Promise
+import expo.modules.kotlin.functions.Queues
+import expo.modules.kotlin.modules.Module
+import expo.modules.kotlin.modules.ModuleDefinition
+
+private const val SCAN_REQUEST_CODE = 0x7351
+
+/** Opens ZXing's full-screen scanner and resolves the QR text, or "" when the user backs out. */
+class T3QrScannerModule : Module() {
+  private var pendingScan: Promise? = null
+
+  override fun definition() = ModuleDefinition {
+    Name("T3QrScanner")
+
+    AsyncFunction("scanAsync") { prompt: String, promise: Promise ->
+      val activity = appContext.currentActivity
+      if (activity == null) {
+        promise.reject("E_NO_ACTIVITY", "There is no screen to open the scanner from.", null)
+        return@AsyncFunction
+      }
+      if (pendingScan != null) {
+        promise.reject("E_BUSY", "The scanner is already open.", null)
+        return@AsyncFunction
+      }
+      val options = ScanOptions()
+        .setDesiredBarcodeFormats(ScanOptions.QR_CODE)
+        .setPrompt(prompt)
+        .setBeepEnabled(false)
+        .setOrientationLocked(false)
+      pendingScan = promise
+      try {
+        activity.startActivityForResult(options.createScanIntent(activity), SCAN_REQUEST_CODE)
+      } catch (error: Exception) {
+        pendingScan = null
+        promise.reject("E_SCANNER", "The scanner could not open: ${error.message}", error)
+      }
+    }.runOnQueue(Queues.MAIN)
+
+    OnActivityResult { _, payload ->
+      if (payload.requestCode != SCAN_REQUEST_CODE) return@OnActivityResult
+      val promise = pendingScan ?: return@OnActivityResult
+      pendingScan = null
+      // Expo's release bridge crashes on a null resolve value, so a cancel resolves "".
+      promise.resolve(ScanIntentResult.parseActivityResult(payload.resultCode, payload.data).contents ?: "")
+    }
+
+    OnDestroy {
+      pendingScan?.resolve("")
+      pendingScan = null
+    }
+  }
+}
