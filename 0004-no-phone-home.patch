+/** Accepts only inline images supplied by a trusted provider event. */
+function inlineFaviconUrl(rawUrl: string | null | undefined): string | null {
+  if (!rawUrl || rawUrl.length > 65_536) return null;
   try {
     const url = new URL(rawUrl);
