+    // Privacy build: Chromium spellcheck downloads hunspell dictionaries from Google's CDN.
+    // Turn it off for every session (main window, webviews, preview partitions).
+    Electron.app.on("session-created", (created) => {
+      created.setSpellCheckerEnabled(false);
+      created.setSpellCheckerDictionaryDownloadURL("http://127.0.0.1:9/");
+    });
+
     return { linux, linuxPasswordStoreCommandLine };
   });
 }).pipe(Effect.withSpan("desktop.electron.configureBeforeReady"));
