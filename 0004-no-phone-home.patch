-function faviconUrlForPage(rawUrl: string | null | undefined, _size = 32): string | null {
+// Privacy build: favicons never come from the network. No Google favicon service, no
+// GitHub asset CDN, and no favicon.ico fetches from sites an agent visited. Only inline
+// data: images and pages served from this machine are shown.
+
+function localFaviconUrlForPage(rawUrl: string | null | undefined): string | null {
   if (!rawUrl || rawUrl.length > 4096) return null;
   try {
     const pageUrl = new URL(rawUrl);
     if (pageUrl.protocol !== "http:" && pageUrl.protocol !== "https:") return null;
+    if (!isLoopbackHost(pageUrl.hostname)) return null;
     return new URL("/favicon.ico", pageUrl.origin).href;
   } catch {
     return null;
   }
 }
 
